{
  "name": "ozyconnect-desktop",
  "version": "1.0.0",
  "description": "Trendmax — Masaüstü Paneli",
  "main": "main.js",
  "author": "OziyWeb <oziyweb@hotmail.com>",
  "license": "Proprietary",
  "homepage": "https://www.oziyweb.com.tr",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.oziyweb.ozyconnect",
    "productName": "Trendmax",
    "copyright": "© 2025 OziyWeb",
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "main.js",
      "preload.js",
      "server-url.js",
      "connect.html",
      "connect.js",
      "connect.css",
      "package.json"
    ]
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
