{
  "name": "ozyconnect-desktop",
  "version": "1.0.0",
  "description": "OzyConnect - Masaüstü Uygulama",
  "main": "main.js",
  "author": "OziyWeb <oziyweb@hotmail.com>",
  "license": "Proprietary",
  "homepage": "https://www.oziyweb.com.tr",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "dependencies": {
    "electron": "^28.0.0"
  },
  "build": {
    "appId": "com.oziyweb.ozyconnect",
    "productName": "OzyConnect",
    "copyright": "© 2025 OziyWeb",
    "win": {
      "target": "nsis",
