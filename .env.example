# Uygulama
APP_NAME="Entegratör Yazılımı"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Europe/Istanbul

# Veritabanı
DB_HOST=localhost
DB_PORT=3306
DB_NAME=entegrator_yazilimi
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Şifreleme (32 byte hex — installer otomatik oluşturur)
ENCRYPTION_KEY=

# Oturum
SESSION_LIFETIME=7200
SESSION_NAME=EntegratorYazilimi_session

# Loglama
LOG_LEVEL=DEBUG
LOG_RETENTION_DAYS=7

# SMTP (E-posta)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Entegratör Yazılımı"
SMTP_ENCRYPTION=tls

# Fatura
INVOICE_SERIES=OMR
INVOICE_START_NO=1
INVOICE_AUTO_CREATE=false

# Feed
FEED_CACHE_HOURS=4

# Rate Limit
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
API_RATE_LIMIT_PER_SECOND=10
